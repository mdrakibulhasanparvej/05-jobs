{
	"name": "@gs/jobs",
	"version": "0.1.0",
	"private": true,
	"description": "GS jobs service — categories, designations, workplaces, job holders. Owns the jobs schema.",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "node ./dist/server.js",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npx @biomejs/biome check --write",
		"lint": "npx @biomejs/biome lint --write",
		"format": "npx @biomejs/biome format --write",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate deploy",
		"prisma:validate": "prisma validate",
		"legacy:migrate:jobs": "tsx scripts/legacy/migrate-jobs.mts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcryptjs": "^3.0.3",
		"cloudinary": "^2.11.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"ejs": "^6.0.1",
		"express": "^5.2.1",
		"google-auth-library": "^11.3.0",
		"helmet": "^8.3.0",
		"http-status": "^2.1.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.2.0",
		"nodemailer": "^9.0.6",
		"pg": "^8.23.0",
		"redis": "^6.2.1",
		"streamifier": "^0.1.1",
		"stripe": "^22.6.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.4.1",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.23.1",
		"@types/streamifier": "^0.1.2",
		"@types/supertest": "^6.0.2",
		"mongodb": "^7.9.0",
		"prisma": "^7.10.0",
		"supertest": "^7.0.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^3.0.0"
	}
}
