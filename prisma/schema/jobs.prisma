// ───────────── JOBS (05) ─────────────
// Models verbatim from design §5. Service 05-jobs owns this schema.

// Designations are trade-wise: a trade is chosen directly (the academy schema
// already owns the trade catalogue), so there is no separate category layer.
model Designation {
	id          String   @id @default(uuid(7)) @db.Uuid
	tradeId     String   @map("trade_id") @db.Uuid
	name        String
	isActive    Boolean  @default(true) @map("is_active")
	createdById String?  @map("created_by_id") @db.Uuid
	createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
	updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

	trade      Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
	createdBy  User?       @relation("DesignationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
	jobHolders JobHolder[]

	@@unique([tradeId, name]) // + lower(name) case-insensitive index → raw SQL
	@@map("designations")
	@@schema("jobs")
}

model Workplace {
	id          String   @id @default(uuid(7)) @db.Uuid
	name        String // lower(name) unique → raw SQL
	address     String
	contact     String?
	createdById String?  @map("created_by_id") @db.Uuid
	createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
	updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

	createdBy  User?       @relation("WorkplaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
	jobHolders JobHolder[]

	@@map("workplaces")
	@@schema("jobs")
}

// A job holder is always the employment record of one student. Person data
// (name, gender, trade, donor, photo source) lives only on the student side;
// workplace address lives only on the workplace. Nothing is copied here.
model JobHolder {
	id            String   @id @default(uuid(7)) @db.Uuid
	studentId     String   @unique @map("student_id") @db.Uuid
	photoUrl      String?  @map("photo_url")
	designationId String?  @map("designation_id") @db.Uuid
	workplaceId   String?  @map("workplace_id") @db.Uuid
	salary        Decimal? @db.Decimal(12, 2)
	createdById   String?  @map("created_by_id") @db.Uuid
	createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
	updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

	student     StudentInformation @relation(fields: [studentId], references: [id], onDelete: Restrict)
	designation Designation?       @relation(fields: [designationId], references: [id], onDelete: Restrict)
	workplace   Workplace?         @relation(fields: [workplaceId], references: [id])
	createdBy   User?              @relation("JobHolderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

	@@index([designationId])
	@@index([workplaceId])
	@@map("job_holders")
	@@schema("jobs")
}
