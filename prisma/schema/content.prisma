// ───────────── CONTENT (03) ─────────────
// Models verbatim from design §5. Service 03-content owns this schema.

model Headline {
	id        String   @id @default(uuid(7)) @db.Uuid
	titleBn   String   @map("title_bn")
	titleEn   String   @map("title_en")
	isActive  Boolean  @default(true) @map("is_active")
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

	@@map("headlines")
	@@schema("content")
}

model Banner {
	id            String   @id @default(uuid(7)) @db.Uuid
	imageUrl      String   @map("image_url")
	imagePublicId String?  @map("image_public_id")
	title         String?
	isActive      Boolean  @default(true) @map("is_active")
	createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
	updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

	@@index([isActive])
	@@map("banners")
	@@schema("content")
}

model News {
	id            String    @id @default(uuid(7)) @db.Uuid
	title         String
	description   String?
	publishedOn   DateTime? @map("published_on") @db.Date
	imageUrl      String?   @map("image_url")
	imagePublicId String?   @map("image_public_id")
	isActive      Boolean   @default(true) @map("is_active")
	createdById   String?   @map("created_by_id") @db.Uuid
	createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
	updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

	createdBy User? @relation("NewsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

	@@index([isActive, createdAt(sort: Desc)])
	@@map("news")
	@@schema("content")
}
