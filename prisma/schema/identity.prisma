// ───────────── IDENTITY (01) ─────────────
// Models verbatim from design §5. Every column @map("snake_case"),
// every model @@map("snake_case_plural"), every model/enum @@schema("identity").
// Note (ঘ): every `*ById` column carries a real FK to identity.users with
// onDelete: SetNull and a distinct relation name (back-relations listed on User).

// Enums live in enum.prisma (single enum file) — do not declare enums here.

model User {
	id            String    @id @default(uuid(7)) @db.Uuid
	email         String    @unique // always lowercase+trim (Zod transform)
	name          String?
	avatarUrl     String?   @map("avatar_url")
	avatarPublicId String?  @map("avatar_public_id") // for Cloudinary delete
	phone         String?
	dateOfBirth   DateTime? @map("date_of_birth") @db.Date
	gender        Gender?
	bloodGroup    String?   @map("blood_group")
	nidOrBirthNo  String?   @map("nid_or_birth_no") // students.nid_birth + users.nid merged into one column
	role          Role      @default(STUDENT)
	status        UserStatus @default(PENDING)
	passwordHash  String?   @map("password_hash") // null = Google-only / migrated
	googleSub     String?   @unique @map("google_sub")
	emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
	lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
	approvedById  String?   @map("approved_by_id") @db.Uuid // who approved/rejected the registration
	approvedAt    DateTime? @map("approved_at") @db.Timestamptz
	statusReason  String?   @map("status_reason") // reason for REJECTED/BLOCKED
	legacyMongoId String?   @unique @map("legacy_mongo_id") @db.Char(24)
	createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
	updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
	deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

	addresses      UserAddress[]
	employee       EmployeeProfile?
	refreshTokens  RefreshToken[]
	authTokens     AuthToken[]
	trainerTrades  TrainerTrade[]
	assignments    CourseAssignment[]
	unlocks        VideoUnlock[]
	progress       VideoProgress[]
	gatewayCustomers GatewayCustomer[]
	applicantTrade ApplicantTrade?
	studentTraining StudentTraining?
	donations      Payment[]
	feedback       StudentFeedback[]

	// self relation — who approved this user
	approvedBy    User?  @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
	approvedUsers User[] @relation("UserApprovedBy")

	// *ById FKs from other schemas (design §5 note ঘ) — back-relations
	remarksAuthored         StudentRemark[]        @relation("StudentRemarkAuthor")
	coursesCreated          Course[]               @relation("CourseCreatedBy")
	assignmentsMade         CourseAssignment[]     @relation("CourseAssignmentAssignedBy")
	unlocksGranted          VideoUnlock[]          @relation("VideoUnlockGrantedBy")
	feePlansCreated         FeePlan[]              @relation("FeePlanCreatedBy")
	paymentsReceived        Payment[]              @relation("PaymentReceivedBy")
	paymentsVerified        Payment[]              @relation("PaymentVerifiedBy")
	refundsCreated          PaymentRefund[]        @relation("PaymentRefundCreatedBy")
	newsCreated             News[]                 @relation("NewsCreatedBy")
	videoGalleriesCreated   VideoGallery[]         @relation("VideoGalleryCreatedBy")
	pictureGalleriesCreated PictureGallery[]       @relation("PictureGalleryCreatedBy")
	storiesCreated          SuccessStory[]         @relation("SuccessStoryCreatedBy")
	designationsCreated     Designation[]          @relation("DesignationCreatedBy")
	workplacesCreated       Workplace[]            @relation("WorkplaceCreatedBy")
	jobHoldersCreated       JobHolder[]            @relation("JobHolderCreatedBy")

	@@index([role, status])
	@@index([nidOrBirthNo])
	@@index([phone])
	@@index([createdAt(sort: Desc)])
	@@map("users")
	@@schema("identity")
}

model UserAddress {
	id       String      @id @default(uuid(7)) @db.Uuid
	userId   String      @map("user_id") @db.Uuid
	kind     AddressKind
	address  String?
	division String?
	district String?
	upazila  String?
	union     String?     @map("union")
	user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@unique([userId, kind])
	@@map("user_addresses")
	@@schema("identity")
}

model EmployeeProfile {
	userId          String   @id @map("user_id") @db.Uuid
	identityCardNo  String?  @map("identity_card_no") @unique
	designation     String?
	joiningDate     DateTime? @map("joining_date") @db.Date
	dateOfIssue     DateTime? @map("date_of_issue") @db.Date
	salary          Decimal? @db.Decimal(12, 2)
	user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@map("employee_profiles")
	@@schema("identity")
}

model RefreshToken {
	id        String    @id @default(uuid(7)) @db.Uuid
	userId    String    @map("user_id") @db.Uuid
	tokenHash String    @unique @map("token_hash") // SHA-256; raw token never stored
	familyId  String    @map("family_id") @db.Uuid // rotation reuse-detection
	expiresAt DateTime  @map("expires_at") @db.Timestamptz
	revokedAt DateTime? @map("revoked_at") @db.Timestamptz
	userAgent String?   @map("user_agent")
	ip        String?
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
	user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@index([userId])
	@@index([familyId])
	@@map("refresh_tokens")
	@@schema("identity")
}

model AuthToken {
	id        String           @id @default(uuid(7)) @db.Uuid
	userId    String           @map("user_id") @db.Uuid
	purpose   AuthTokenPurpose
	tokenHash String           @unique @map("token_hash")
	expiresAt DateTime         @map("expires_at") @db.Timestamptz
	usedAt    DateTime?        @map("used_at") @db.Timestamptz
	user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@index([userId, purpose])
	@@map("auth_tokens")
	@@schema("identity")
}

model AuditLog {
	// append-only; every service INSERTs, nobody updates or deletes
	id        BigInt   @id @default(autoincrement())
	actorId   String?  @map("actor_id") @db.Uuid // deliberately NOT an FK (log survives user deletion)
	service   String
	action    String // e.g. "student.status.update"
	entity    String
	entityId  String   @map("entity_id")
	diff      Json?
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

	@@index([entity, entityId])
	@@index([actorId, createdAt(sort: Desc)])
	@@map("audit_logs")
	@@schema("identity")
}
